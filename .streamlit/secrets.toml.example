# Copy this file to .streamlit/secrets.toml for local use.
# Never commit the real secrets.toml file.

GROQ_API_KEY = "gsk_your_key_here"
OPENROUTER_API_KEY = "sk-or-v1-your_key_here"

GROQ_ROUTER_MODEL = "llama-3.1-8b-instant"
GROQ_ANSWER_MODEL = "llama-3.3-70b-versatile"
OPENROUTER_ANSWER_MODEL = "openai/gpt-oss-20b"
